        {
          "id": "main",
          "path": "main"
        },
        {
          "id": "label",
          "path": "label"
        },
        {
          "id": "footer",
          "path": "footer"
        },
        {
          "id": "weather",
          "path": "weather"
        },
        {
          "id": "sun",
          "path": "sun"
        },
        {
          "id": "cloud",
          "path": "cloud"
        },
        {
          "id": "precip",
          "path": "precip"
        },
        {
          "id": "screen",
          "path": "screen"
        }
      ]
    },
