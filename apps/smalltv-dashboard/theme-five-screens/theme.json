      "x": 12,
      "y": 16,
      "value": "{feed.title}",
      "size": 16,
      "color": "#E8EEF5",
      "bind": {
        "y": {
          "source": "weather.screen",
          "input": [
            0,
            1
          ],
          "output": [
            479,
            16
          ],
          "clamp": true
        }
      }
    },
