[Unit]
Description=Publish a limited Homelab status summary for SmallTV
After=homelab-monitor.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /home/pentagon-admin/Documents/homelab/apps/smalltv-dashboard/export_monitor.py
StateDirectory=smalltv-dashboard
StateDirectoryMode=0755
UMask=0022
TimeoutStartSec=10
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
