# Copy to .env; never commit real values. Pin a tested stable arm64 image digest.
HERMES_IMAGE=nousresearch/hermes-agent:stable
GLM_API_KEY=
MATRIX_HOMESERVER=https://matrix.pentagonlab.org
MATRIX_ACCESS_TOKEN=
MATRIX_ALLOWED_USERS=@your-user:pentagonlab.org
MATRIX_ALLOWED_ROOMS=!your-private-room:pentagonlab.org
MATRIX_HOME_ROOM=!your-private-room:pentagonlab.org
GATEWAY_TOKEN=
APPROVER_TOKEN=
BROKER_TOKEN=
DOCKER_GID=
KNOWLEDGE_ROUTER_PATH=/home/pentagon-admin/Documents/apps/knowledge-router
CODING_VAULT_PATH=/home/pentagon-admin/Documents/apps/obsidian-vaults/coding
# Optional existing API endpoint; gateway POSTs {workflow,input}, expects {success:true,...}.
# Attach that API container to personal-agent_upstream. Do not publish it publicly.
FLOWFORGE_URL=http://flowforge-api:8082
FLOWFORGE_TOKEN=

# Existing read-only FlowForge/target checkout and native ARM64 OpenCode binary.
FLOWFORGE_PATH=/home/pentagon-admin/Documents/apps/flow-forge-tui
MENTORY_PROJECT_PATH=/home/pentagon-admin/Documents/apps/mentory
OPENCODE_BINARY=/home/pentagon-admin/.opencode/bin/opencode
