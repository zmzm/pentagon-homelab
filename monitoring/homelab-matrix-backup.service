[Unit]
Description=Consistent Matrix PostgreSQL database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /home/pentagon-admin/Documents/homelab/scripts/backup_matrix_db.py
UMask=0077
TimeoutStartSec=300
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pentagon-admin/Documents/homelab/data/matrix/database-backup
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
